{
  "crons": [
    {
      "path": "/api/cron/send-scheduled-reports?trigger=monthly",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/send-scheduled-reports?trigger=thursday",
      "schedule": "0 11 * * 4"
    }
  ],
  "functions": {
    "api/run-pipeline.py": {
      "maxDuration": 800
    },
    "app/api/reports/run/route.ts": {
      "maxDuration": 800
    },
    "app/api/cron/send-scheduled-reports/route.ts": {
      "maxDuration": 800
    }
  }
}
